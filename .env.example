NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_USER=market_user
DB_PASSWORD=change_me
DB_NAME=steam_market
JWT_SECRET=use_a_long_random_secret_of_at_least_32_characters
# Comma-separated allowed browser origins. Required in production.
CORS_ORIGIN=http://localhost:5173
# Mercado Pago Checkout Pro (Argentina). Never expose MP_ACCESS_TOKEN in the frontend.
MP_ACCESS_TOKEN=TEST-your_test_access_token
MP_WEBHOOK_SECRET=your_webhook_secret_from_mercado_pago
# Public HTTPS URL, for example the HTTPS URL shown by ngrok plus /api/webhooks/mercadopago
MP_WEBHOOK_URL=https://your-public-domain.ngrok-free.app/api/webhooks/mercadopago
